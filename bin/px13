#!/usr/bin/env bash
set -euo pipefail

SELF="/usr/local/bin/px13"
STATE_DIR="/var/lib/px13"
MODE_FILE="${STATE_DIR}/mode"
RUN_DIR="/run/px13"
LIVE_FILE="${RUN_DIR}/state"
LOCK_FILE="${RUN_DIR}/lock"
RYZENADJ="/usr/local/bin/ryzenadj"
ENVYCONTROL_HELPER="/usr/local/bin/px13-envycontrol"
ENVYCONTROL="/opt/envycontrol/bin/envycontrol"
PLATFORM_PROFILE="/sys/firmware/acpi/platform_profile"
NVIDIA_BLACKLIST="/etc/modprobe.d/blacklist-nvidia.conf"
CO_NEG25="0xFFFE7"
WATCH_INTERVAL=60
AC_ONLINE="/sys/class/power_supply/AC0/online"

# ASUS WMI via the asus-nb-wmi debugfs interface. The EC applies these power
# limits itself (WMI 0x001200A3/A0/C1 -> EC cmds 0x29/0x28/0x2D, 1 byte, W),
# so the EC's own staged mode changes no longer overwrite them.
WMI_DEBUGFS="/sys/kernel/debug/asus-nb-wmi"
WMI_PL1_SPL=0x001200A3
WMI_PL2_SPPT=0x001200A0
WMI_PL3_FPPT=0x001200C1
# Measured EC ceilings (STAPM slow fast, W); requests above are clamped.
EC_CEILING_AC="65 70 85"
EC_CEILING_DC="56 65 85"
# The EC accepts anything down to 5 W; refuse values that low ourselves.
EC_MIN_W=8
EC_MAX_W=120

# Firmware GPU Eco (ProArt/Vivo ID; the ROG 0x00090020 is not implemented).
# 1 = EC cmd 0x45, firmware asks the OS to eject the dGPU, sets UMAF in CMOS.
# 0 = firmware powers the dGPU back on; Linux must rescan the bridge.
WMI_GPU_ECO=0x00090120
NVIDIA_BRIDGE="/sys/bus/pci/devices/0000:00:03.1"
# EnvyControl's integrated-mode rule deletes the dGPU from PCI as soon as it
# appears, which would break both the rescan and the firmware eject.
ENVY_REMOVE_RULE="/etc/udev/rules.d/50-remove-nvidia.rules"

# GPU policy: manual (Eco/Hybrid as clicked) or optimized (like Windows:
# Eco on battery, Hybrid on AC). Optimized acts only once AC has been stable
# for OPTIMIZED_SETTLE seconds, so quick plug/unplug does not flap the GPU.
GPU_POLICY_FILE="${STATE_DIR}/gpu_policy"
AC_SINCE_FILE="${RUN_DIR}/ac_since"
GPU_BUSY_FILE="${RUN_DIR}/gpu_busy"
OPTIMIZED_SETTLE=10

# GPU Eco switches run the firmware's PCIe routine (ALIB) for the dGPU link.
# The USB4 host interfaces' runtime suspend (_PS3) uses ALIB too; on
# 2026-10-15 the two overlapped during a Hybrid switch, ALIB timed out and
# the SMU stopped responding (hard freeze). So the USB4 interfaces are kept
# awake during a switch, and switches are spaced at least this far apart.
GPU_SWITCH_COOLDOWN=30
GPU_SWITCHED_FILE="${RUN_DIR}/gpu_switched"
# Stopped automatically before GPU Eco; never listed as apps to close.
NVIDIA_SERVICES="nvidia-persistenced.service nvidia-powerd.service"
# Session processes that are never closed for GPU Eco.
PROTECTED_PROCS="kwin_wayland Xwayland plasmashell systemd systemd-logind"

# mode -> "power-profile stapm_mW slow_mW fast_mW"
# eco is the fanless battery mode: 12 W sustained sits on the measured
# energy-per-task optimum (8-20 W) and settled near 58 C after 7 min with the
# fans held off; 25 W fast lasts ~4 s through the EC, enough for page loads.
# perf: 62 W sustained is the measured sweet spot with perf's fan curve
# (warm chassis, 4 min: 34.7 GB/s SHA / 723 GFLOP/s FMA, within 1% of 70 W or
# better, 2-7 C cooler); 85 W fast for bursts. Battery clamps to 56/62/85.
declare -A MODES=(
  [eco]="power-saver 12000 12000 25000"
  [normal]="balanced 25000 25000 35000"
  [perf]="performance 62000 62000 85000"
)
# EPP per mode, enforced in every mode: the clamp fix restores the EPP it
# saw, which can be a stale one from mid profile change. power-saver's
# "power" made 15 ms bursts 36% slower than balance_power with no
# measurable energy saving (px13-sweep); normal follows the daemon's own
# choice (balance_power on battery, balance_performance on AC).
mode_epp() {
  case "$1" in
    eco) echo balance_power ;;
    normal) on_ac && echo balance_performance || echo balance_power ;;
    perf) echo performance ;;
  esac
}

# Fan curves (asusctl format, 8 points) per mode; asusd stores them per
# profile, px13 re-checks them like the limits. normal keeps asusd's stock
# Balanced curve.
# eco (Quiet): off up to 70 C, ramping in above it only as a safety net. The
# stock Quiet curve starts the fans at 48-52 C, which even 9 W sustained
# reaches.
# perf (Performance): the stock shape at low temperatures, then up to 100%
# at 82 C. The stock curve tops out at 74%: at 70 W it pinned 95 C and
# throttled as the chassis heated, while this curve held 87.5 C at 65 W.
FANLESS_CURVE="30c:0%,45c:0%,55c:0%,65c:0%,70c:0%,75c:25%,80c:50%,85c:100%"
PERF_CURVE="49c:1%,52c:6%,55c:12%,58c:26%,61c:34%,67c:60%,75c:85%,82c:100%"

# CPU mode follows the power source: perf on AC, eco on battery. A manual
# choice holds until the next plug/unplug. "px13 auto off" disables it.
CPU_POLICY_FILE="${STATE_DIR}/cpu_policy"
# AC state (0/1) the auto policy last acted on; /run, so boot decides afresh.
CPU_AUTO_AC_FILE="${RUN_DIR}/cpu_auto_ac"

usage() {
  cat <<'EOF'
Usage: px13 {eco|normal|perf|cycle|auto|status|deep-eco|deep-eco-close|hybrid|optimized|gpu-users|reapply|check|watch|state}

  eco       fanless: power-saver, 12W/12W/25W, EPP balance_power, fans off below
            70 C, CO -25, NVIDIA PCI runtime auto
  normal    balanced, 25W/25W/35W, CO -25, NVIDIA PCI runtime auto
  perf      performance, 62W/62W/85W (56/62/85 on battery), EPP performance,
            fans up to 100% at 82 C, CO -25
  cycle     eco -> normal -> perf -> eco
            (changing the power profile elsewhere, e.g. KDE or Fn+F5, switches mode too)
  auto [on|off]
            CPU mode follows power (default on): perf on AC, eco on battery;
            a manual mode choice holds until the next plug/unplug
  status    full report: mode, live limits, battery, GPU, RyzenAdj
  deep-eco  firmware GPU Eco on: NVIDIA GPU powered off, live (no reboot)
  deep-eco-close
            the same, after closing your apps that use the GPU (TERM, then
            KILL after 5s)
  gpu-users list the processes using the NVIDIA GPU ("pid name" per line)
  hybrid    firmware GPU Eco off: NVIDIA GPU back on the bus (first switch from
            EnvyControl integrated rebuilds the driver config, ~3 min)
  optimized GPU follows power: Eco on battery, Hybrid on AC (deep-eco or
            hybrid switch back to manual)
  reapply   re-apply the stored mode (used after boot, resume and AC changes)
  check     re-apply the stored mode only if firmware has overridden the limits
  watch     follow profile/AC changes, check every 60s, publish state (px13-watch.service)
  state     print live state as key=value (for the panel widget)
EOF
}

log() {
  # Goes to the journal when run from systemd, and to the terminal otherwise.
  echo "$*"
}

notify() {
  [[ -n "${PX13_NO_NOTIFY:-}" ]] && return 0
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a "PX13 Power" -i preferences-system-power-management "$1" "${2:-}" >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------- stored mode

valid_mode() {
  [[ -n "${1:-}" && -n "${MODES[$1]:-}" ]]
}

profile_mode() {
  case "$1" in
    power-saver) echo eco ;;
    balanced) echo normal ;;
    performance) echo perf ;;
    *) echo unknown ;;
  esac
}

mode_profile() {
  if valid_mode "$1"; then
    echo "${MODES[$1]%% *}"
  else
    echo unknown
  fi
}

# Uses only builtins: the watcher calls this every couple of seconds.
stored_mode() {
  local mode=""
  if [[ -r "${MODE_FILE}" ]]; then
    read -r mode < "${MODE_FILE}" || true
  fi
  if valid_mode "${mode}"; then
    printf '%s\n' "${mode}"
  else
    printf 'unknown\n'
  fi
}

write_mode() {
  install -d -m 755 "${STATE_DIR}"
  printf '%s\n' "$1" > "${MODE_FILE}.tmp"
  chmod 644 "${MODE_FILE}.tmp"
  mv -f "${MODE_FILE}.tmp" "${MODE_FILE}"
}

# ------------------------------------------------------------- live readings

current_profile() {
  local p=""
  read -r p 2>/dev/null < "${PLATFORM_PROFILE}" || true
  case "${p}" in
    quiet|low-power) echo power-saver ;;
    balanced) echo balanced ;;
    performance) echo performance ;;
    *) echo unknown ;;
  esac
}

# Prints "stapm slow fast" in watts, or nothing if RyzenAdj cannot read them.
read_limits() {
  "${RYZENADJ}" -i 2>/dev/null | awk -F'|' '
    /STAPM LIMIT/    { gsub(/ /, "", $3); s = $3 }
    /PPT LIMIT SLOW/ { gsub(/ /, "", $3); l = $3 }
    /PPT LIMIT FAST/ { gsub(/ /, "", $3); f = $3 }
    END { if (s != "" && l != "" && f != "") printf "%s %s %s\n", s, l, f }'
}

# limits_match "<stapm slow fast in W>" <mode>
# Firmware may clamp a request downward (perf STAPM 70 -> 65), so accept
# anything between 85% and 100% of each requested value. In perf, firmware
# also trims further on battery (to 56/65/80 W) a few seconds later; accept
# down to 75% so the watcher doesn't fight that every 20s.
on_ac() {
  local ac=0
  read -r ac 2>/dev/null < "${AC_ONLINE}" || true
  [[ "${ac}" == 1 ]]
}

# Prints the "stapm slow fast" watts the EC will actually give for a mode:
# the request clamped to the ceiling for the current power source.
expected_limits() {
  local _profile stapm slow fast ceiling
  read -r _profile stapm slow fast <<< "${MODES[$1]}"
  if on_ac; then ceiling="${EC_CEILING_AC}"; else ceiling="${EC_CEILING_DC}"; fi
  awk -v r="${stapm} ${slow} ${fast}" -v c="${ceiling}" 'BEGIN {
    split(r, rv, " "); split(c, cv, " ")
    for (i = 1; i <= 3; i++) {
      w = rv[i] / 1000
      printf "%d%s", (w < cv[i] ? w : cv[i]), (i < 3 ? " " : "\n")
    }
  }'
}

# limits_match "<stapm slow fast in W>" <mode>
# Accept anything between the clamped expectation (minus 1 W) and the raw
# request (plus 0.5 W), so the RyzenAdj fallback also verifies.
limits_match() {
  local actual="$1" mode="$2" _profile stapm slow fast
  read -r _profile stapm slow fast <<< "${MODES[$mode]}"
  [[ -n "${actual}" ]] || return 1
  awk -v a="${actual}" -v r="${stapm} ${slow} ${fast}" -v e="$(expected_limits "${mode}")" 'BEGIN {
    n = split(a, av, " "); split(r, rv, " "); split(e, ev, " ")
    if (n != 3) exit 1
    for (i = 1; i <= 3; i++) {
      if (av[i] > rv[i] / 1000 + 0.5 || av[i] < ev[i] - 1) exit 1
    }
  }'
}

nvidia_devices() {
  local dev
  for dev in /sys/bus/pci/devices/*; do
    [[ "$(cat "${dev}/vendor" 2>/dev/null)" == "0x10de" ]] || continue
    # Only the display/3D controller functions (class 0x03xxxx).
    [[ "$(cat "${dev}/class" 2>/dev/null)" == 0x03* ]] || continue
    basename "${dev}"
  done
}

# All PCI functions of the dGPU (display, HDMI audio, ...).
nvidia_functions() {
  local dev
  for dev in /sys/bus/pci/devices/*; do
    [[ "$(cat "${dev}/vendor" 2>/dev/null)" == "0x10de" ]] && basename "${dev}"
  done
}

gpu_driver() {
  local dev drv
  for dev in $(nvidia_devices); do
    drv="$(readlink "/sys/bus/pci/devices/${dev}/driver" 2>/dev/null || true)"
    [[ -n "${drv}" ]] && { basename "${drv}"; return 0; }
  done
  echo none
}

# Why a powered GPU has no driver: none | no_module | blacklisted | not_loaded
gpu_driver_issue() {
  if [[ "$(gpu_driver)" != none || -z "$(nvidia_devices)" ]]; then
    echo none
  elif ! modinfo -k "$(uname -r)" -n nvidia >/dev/null 2>&1; then
    echo no_module
  elif [[ -e "${NVIDIA_BLACKLIST}" ]]; then
    echo blacklisted
  else
    echo not_loaded
  fi
}

gpu_eco_state() {
  if ! ec_available; then
    echo unknown
    return 0
  fi
  case "$(wmi_dsts "${WMI_GPU_ECO}")" in
    0x10001) echo on ;;
    0x10000) echo off ;;
    *) echo unknown ;;
  esac
}

gpu_config() {
  if [[ -e "${NVIDIA_BLACKLIST}" ]]; then echo integrated; else echo hybrid; fi
}

# Writes the live state file the widget reads; must run as root.
publish_state() {
  local mode limits applied gpu_cfg gpu_present="no" pending="no" eco drv issue
  mode="$(stored_mode)"
  limits="$(read_limits || true)"
  if [[ "${mode}" == unknown ]]; then
    applied="unknown"
  elif limits_match "${limits}" "${mode}"; then
    applied="yes"
  else
    applied="drifted"
  fi
  gpu_cfg="$(gpu_config)"
  [[ -n "$(nvidia_devices)" ]] && gpu_present="yes"
  eco="$(gpu_eco_state)"
  drv="$(gpu_driver)"
  # Only a blacklisted driver (EnvyControl config not yet booted) is fixed by
  # a reboot; a missing module for the running kernel is not.
  issue="$(gpu_driver_issue)"
  if [[ "${eco}" == off && "${issue}" == blacklisted ]]; then
    pending="yes"
  fi

  install -d -m 755 "${RUN_DIR}"
  local tmp
  # Unique temp file: `px13 state` and the watcher can publish at once.
  tmp="$(mktemp "${RUN_DIR}/state.XXXXXX")"
  {
    printf 'mode=%s\n' "${mode}"
    printf 'profile=%s\n' "$(current_profile)"
    printf 'expected_profile=%s\n' "$(mode_profile "${mode}")"
    printf 'limits=%s\n' "${limits:-unknown}"
    printf 'cpu_clamped=%s\n' "$(pstate_clamped && echo yes || echo no)"
    printf 'epp=%s\n' "$(current_epp)"
    printf 'cpu_policy=%s\n' "$(cpu_policy)"
    printf 'fanless=%s\n' "$(fanless_curve_active && echo yes || echo no)"
    printf 'fan_curve=%s\n' "$(fanless_curve_active && echo eco || { fan_curve_active "${PERF_CURVE}" && echo perf || echo stock; })"
    printf 'applied=%s\n' "${applied}"
    printf 'limit_path=%s\n' "$(ec_available && echo ec || echo ryzenadj)"
    printf 'gpu_config=%s\n' "${gpu_cfg}"
    printf 'gpu_present=%s\n' "${gpu_present}"
    printf 'gpu_eco=%s\n' "${eco}"
    printf 'gpu_driver=%s\n' "${drv}"
    printf 'gpu_driver_issue=%s\n' "${issue}"
    printf 'gpu_policy=%s\n' "$(gpu_policy)"
    printf 'gpu_busy=%s\n' "$(cat "${GPU_BUSY_FILE}" 2>/dev/null || true)"
    printf 'reboot_pending=%s\n' "${pending}"
    printf 'updated=%s\n' "$(date +%s)"
  } > "${tmp}"
  chmod 644 "${tmp}"
  mv -f "${tmp}" "${LIVE_FILE}"
}

# ------------------------------------------------------------------- applying

set_nvidia_auto() {
  local dev
  for dev in $(nvidia_devices); do
    printf 'auto\n' > "/sys/bus/pci/devices/${dev}/power/control" 2>/dev/null || true
  done
}

ec_available() {
  [[ -w "${WMI_DEBUGFS}/dev_id" && -w "${WMI_DEBUGFS}/ctrl_param" && -r "${WMI_DEBUGFS}/devs" ]]
}

# debugfs has one shared dev_id/ctrl_param pair, so every call takes this
# lock: an unlocked status read racing a limit write could send a watt value
# to the GPU Eco switch. GPU Eco off holds it ~1s (up to ~20s if the link
# never comes up).
wmi_locked() {
  (
    flock -w 40 7 || { echo "WMI lock timeout" >&2; exit 1; }
    "$@"
  ) 7> "${RUN_DIR}/wmi.lock"
}

_wmi_devs() {
  local out
  printf '%s\n' "$1" > "${WMI_DEBUGFS}/dev_id"
  printf '%s\n' "$2" > "${WMI_DEBUGFS}/ctrl_param"
  out="$(cat "${WMI_DEBUGFS}/devs")"
  printf '%s\n' "${out##*= }"
}

_wmi_dsts() {
  local out
  printf '%s\n' "$1" > "${WMI_DEBUGFS}/dev_id"
  out="$(cat "${WMI_DEBUGFS}/dsts" 2>/dev/null || true)"
  printf '%s\n' "${out##*= }"
}

# wmi_devs <dev_id> <value>: prints the WMI return value (e.g. 0x1).
wmi_devs() {
  install -d -m 755 "${RUN_DIR}"
  wmi_locked _wmi_devs "$@"
}

# wmi_dsts <dev_id>: prints the raw status (e.g. 0x10001).
wmi_dsts() {
  install -d -m 755 "${RUN_DIR}"
  wmi_locked _wmi_dsts "$@"
}

# ec_set_limits <stapm_mW> <slow_mW> <fast_mW>
ec_set_limits() {
  local ids=("${WMI_PL1_SPL}" "${WMI_PL2_SPPT}" "${WMI_PL3_FPPT}") vals i w rc
  vals=("$(( $1 / 1000 ))" "$(( $2 / 1000 ))" "$(( $3 / 1000 ))")
  for i in 0 1 2; do
    w="${vals[$i]}"
    if ((w < EC_MIN_W || w > EC_MAX_W)); then
      echo "Refusing EC power limit ${w} W (allowed ${EC_MIN_W}-${EC_MAX_W} W)." >&2
      return 1
    fi
  done
  for i in 0 1 2; do
    rc="$(wmi_devs "${ids[$i]}" "${vals[$i]}")"
    if [[ "${rc}" != 0x1 ]]; then
      echo "EC rejected ${ids[$i]}=${vals[$i]} (returned ${rc})." >&2
      return 1
    fi
  done
}

# Poll for up to 3s until the limits match the mode.
wait_for_limits() {
  local mode="$1" i
  for ((i = 0; i < 6; i++)); do
    sleep 0.5
    limits_match "$(read_limits || true)" "${mode}" && return 0
  done
  return 1
}

run_ryzenadj_limits() {
  local stapm="$1" slow="$2" fast="$3"
  "${RYZENADJ}" \
    --stapm-limit="${stapm}" \
    --slow-limit="${slow}" \
    --fast-limit="${fast}" \
    --set-coall="${CO_NEG25}" >/dev/null 2>&1
}

# Changing the platform profile makes the firmware write its own power limits
# roughly a second later, overwriting anything RyzenAdj set before that.
# Wait until the limits move away from what they were, or 3s at most.
wait_for_firmware() {
  local before="$1" i now
  for ((i = 0; i < 12; i++)); do
    sleep 0.25
    now="$(read_limits || true)"
    if [[ -n "${now}" && "${now}" != "${before}" ]]; then
      sleep 0.3
      return 0
    fi
  done
}

fan_curve_hwmon() {
  local h n
  for h in /sys/class/hwmon/hwmon*; do
    read -r n 2>/dev/null < "${h}/name" || continue
    [[ "${n}" == asus_custom_fan_curve ]] && { printf '%s\n' "${h}"; return 0; }
  done
  return 1
}

mode_fan_curve() {
  case "$1" in
    eco) echo "${FANLESS_CURVE}" ;;
    perf) echo "${PERF_CURVE}" ;;
  esac
}

mode_asus_profile() {
  case "$1" in
    eco) echo Quiet ;;
    normal) echo Balanced ;;
    perf) echo Performance ;;
  esac
}

# True if both fans of the active profile run <curve>: custom curve enabled,
# every point at its temperature and within 2 of its PWM percentage.
fan_curve_active() {
  local curve="$1" h fan i point t pct v want
  local -a points
  h="$(fan_curve_hwmon)" || return 1
  IFS=, read -ra points <<< "${curve}"
  for fan in 1 2; do
    read -r v < "${h}/pwm${fan}_enable" && [[ "${v}" == 1 ]] || return 1
    i=0
    for point in "${points[@]}"; do
      i=$((i + 1))
      t="${point%%c:*}"
      pct="${point##*:}"
      pct="${pct%\%}"
      read -r v < "${h}/pwm${fan}_auto_point${i}_temp" && [[ "${v}" == "${t}" ]] || return 1
      read -r v < "${h}/pwm${fan}_auto_point${i}_pwm" || return 1
      want=$((pct * 255 / 100))
      ((v - want <= 2 && want - v <= 2)) || return 1
    done
  done
}

fanless_curve_active() {
  fan_curve_active "${FANLESS_CURVE}"
}

# Sets the mode's fan curve if it has one and the profile is active; sets
# FANS_CHANGED=1 when it wrote one. Enabling a custom curve makes the EC load
# other power limits about a second later, so callers re-apply the limits.
FANS_CHANGED=0
apply_mode_fans() {
  local curve prof fan
  FANS_CHANGED=0
  curve="$(mode_fan_curve "$1")"
  [[ -n "${curve}" && "$(current_profile)" == "$(mode_profile "$1")" ]] || return 0
  command -v asusctl >/dev/null 2>&1 || return 0
  fan_curve_active "${curve}" && return 0
  prof="$(mode_asus_profile "$1")"
  for fan in cpu gpu; do
    asusctl fan-curve --mod-profile "${prof}" --fan "${fan}" --data "${curve}" >/dev/null 2>&1 || true
  done
  asusctl fan-curve --mod-profile "${prof}" --enable-fan-curves true >/dev/null 2>&1 || true
  FANS_CHANGED=1
  if fan_curve_active "${curve}"; then
    log "Fan curve set for $1 (${prof}: ${curve})."
  else
    log "Could not set the $1 fan curve via asusctl."
  fi
}

current_epp() {
  local e=""
  read -r e 2>/dev/null < /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference || true
  printf '%s\n' "${e}"
}

# Sets the mode's EPP on every CPU if it has one and differs; logs on change.
apply_mode_epp() {
  local want f
  want="$(mode_epp "$1")"
  [[ -n "${want}" && "$(current_epp)" != "${want}" ]] || return 0
  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/energy_performance_preference; do
    printf '%s\n' "${want}" > "${f}" 2>/dev/null || true
  done
  log "EPP set to ${want} for $1."
}

cpu_policy() {
  local policy=""
  read -r policy 2>/dev/null < "${CPU_POLICY_FILE}" || true
  [[ "${policy}" == manual ]] && echo manual || echo auto
}

# Auto policy: once per power-source change, switch to perf on AC and eco on
# battery. Caller holds the px13 lock.
cpu_auto_apply() {
  local ac=0 last="" mode power=battery
  [[ "$(cpu_policy)" == auto ]] || return 0
  on_ac && { ac=1; power=AC; }
  read -r last 2>/dev/null < "${CPU_AUTO_AC_FILE}" || true
  [[ "${last}" != "${ac}" ]] || return 0
  printf '%s\n' "${ac}" > "${CPU_AUTO_AC_FILE}"
  if ((ac)); then mode=perf; else mode=eco; fi
  [[ "$(stored_mode)" == "${mode}" && "$(current_profile)" == "$(mode_profile "${mode}")" ]] && return 0
  log "Auto: on ${power}, switching to ${mode}."
  write_mode "${mode}"
  apply_mode "${mode}" || true
  if [[ "${mode}" != perf ]]; then
    set_nvidia_auto
  fi
}

auto_cmd() {
  case "${1:-on}" in
    on)
      with_lock
      printf 'auto\n' > "${CPU_POLICY_FILE}"
      rm -f "${CPU_AUTO_AC_FILE}"
      cpu_auto_apply
      publish_state
      echo "Auto mode on: perf on AC, eco on battery. Now in $(stored_mode)."
      ;;
    off)
      install -d -m 755 "${STATE_DIR}"
      printf 'manual\n' > "${CPU_POLICY_FILE}"
      publish_state
      echo "Auto mode off: the mode only changes when you pick one."
      ;;
    *) echo "Usage: px13 auto [on|off]" >&2; return 1 ;;
  esac
}

# apply_mode <mode>; returns 0 if the limits verified.
apply_mode() {
  local rc=0 changed=0 i
  [[ "$(current_profile)" != "$(mode_profile "$1")" ]] && changed=1
  apply_mode_limits "$1" || rc=$?
  apply_mode_epp "$1"
  apply_mode_fans "$1"
  if ((FANS_CHANGED)); then
    sleep 1.5
    rc=0
    apply_mode_limits "$1" || rc=$?
  fi
  if ((changed)); then
    # A profile change can re-trigger the amd_pstate clamp a moment later.
    for i in 1 2 3 4; do
      pstate_clamped && break
      sleep 0.5
    done
    pstate_unclamp
  fi
  return "${rc}"
}

apply_mode_limits() {
  local mode="$1" profile stapm slow fast attempt
  read -r profile stapm slow fast <<< "${MODES[$mode]}"

  if [[ ! -x "${RYZENADJ}" ]]; then
    echo "RyzenAdj not found at ${RYZENADJ}." >&2
    return 1
  fi

  if ec_available; then
    apply_mode_ec "${mode}" && return 0
    echo "EC path did not verify; falling back to RyzenAdj." >&2
  fi
  apply_mode_ryzenadj "${mode}"
}

# The EC reloads its own per-mode limits on a profile change and ignores a
# write sent in the same instant; one sent 0.3s later sticks through the EC's
# delayed ramp stages. RyzenAdj is used only to read back and for CO.
apply_mode_ec() {
  local mode="$1" profile stapm slow fast attempt
  read -r profile stapm slow fast <<< "${MODES[$mode]}"

  if [[ "$(current_profile)" != "${profile}" ]]; then
    if ! powerprofilesctl set "${profile}" >/dev/null 2>&1; then
      echo "Could not set power profile '${profile}'; continuing." >&2
    fi
    sleep 0.3
  fi

  for attempt in 1 2; do
    ec_set_limits "${stapm}" "${slow}" "${fast}" || return 1
    if wait_for_limits "${mode}"; then
      "${RYZENADJ}" --set-coall="${CO_NEG25}" >/dev/null 2>&1 || true
      return 0
    fi
  done
  return 1
}

apply_mode_ryzenadj() {
  local mode="$1" profile stapm slow fast before attempt limits
  read -r profile stapm slow fast <<< "${MODES[$mode]}"

  if [[ "$(current_profile)" != "${profile}" ]]; then
    before="$(read_limits || true)"
    if powerprofilesctl set "${profile}" >/dev/null 2>&1; then
      wait_for_firmware "${before}"
    else
      echo "Could not set power profile '${profile}'; continuing." >&2
    fi
  fi

  for attempt in 1 2 3; do
    run_ryzenadj_limits "${stapm}" "${slow}" "${fast}" || true
    sleep 0.3
    limits="$(read_limits || true)"
    if limits_match "${limits}" "${mode}"; then
      return 0
    fi
    sleep 1
  done
  echo "Limits did not stick after 3 attempts (reading: ${limits:-none} W)." >&2
  return 1
}

with_lock() {
  install -d -m 755 "${RUN_DIR}"
  exec 9> "${LOCK_FILE}"
  if ! flock -w 30 9; then
    echo "Another px13 action is still running." >&2
    exit 1
  fi
}

set_mode() {
  local mode="$1" rc=0 profile stapm slow fast
  read -r profile stapm slow fast <<< "${MODES[$mode]}"
  with_lock
  apply_mode "${mode}" || rc=$?
  if [[ "${mode}" != perf ]]; then
    set_nvidia_auto
  fi
  write_mode "${mode}"
  publish_state

  local limits
  limits="$(read_limits || true)"
  if [[ "${rc}" -eq 0 ]]; then
    printf 'PX13 %s: %s, %s W (STAPM/slow/fast) via %s, CO -25 - verified\n' \
      "${mode}" "${profile}" "$(tr ' ' '/' <<< "${limits}")" "$(ec_available && echo EC || echo RyzenAdj)"
  else
    printf 'PX13 %s: %s, but limits read %s W; px13-watch will keep retrying.\n' \
      "${mode}" "${profile}" "$(tr ' ' '/' <<< "${limits:-?}")"
  fi
  return "${rc}"
}

# amd_pstate on this chip can come up at boot, or fall back after a platform
# profile change or resume, with every core held at the 2.0 GHz nominal clock:
# cpuinfo/scaling max read the nominal frequency while amd_pstate_max_freq
# still reports the boost clock. Re-registering the driver (guided, then
# active) clears it. Seen with asusd + power-profiles-daemon on HX 370 boards.
PSTATE_STATUS="/sys/devices/system/cpu/amd_pstate/status"
PSTATE_FAIL_STAMP="${RUN_DIR}/pstate_fail"
# After a fix that did not clear the clamp, wait this long before retrying.
PSTATE_RETRY=600

pstate_clamped() {
  local pol hw cap scaling nominal
  read -r nominal < /sys/devices/system/cpu/cpu0/acpi_cppc/nominal_freq 2>/dev/null || return 1
  for pol in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
    read -r hw < "${pol}/amd_pstate_max_freq" 2>/dev/null || return 1
    read -r cap < "${pol}/cpuinfo_max_freq" 2>/dev/null || return 1
    read -r scaling < "${pol}/scaling_max_freq" 2>/dev/null || return 1
    ((scaling < cap)) && cap="${scaling}"
    ((cap < hw && cap == nominal * 1000)) && return 0
  done
  return 1
}

pstate_unclamp() {
  local now last gov epp pol
  [[ -w "${PSTATE_STATUS}" ]] && pstate_clamped || return 0
  now="$(date +%s)"
  last="$(cat "${PSTATE_FAIL_STAMP}" 2>/dev/null || echo 0)"
  ((now - last >= PSTATE_RETRY)) || return 0
  read -r gov < /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
  read -r epp < /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference
  log "amd_pstate is clamped to the nominal clock; re-registering the driver."
  echo guided > "${PSTATE_STATUS}" || true
  sleep 1
  echo active > "${PSTATE_STATUS}" || true
  # Re-registering resets governor and EPP; put back what the profile chose.
  for pol in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
    echo "${gov}" > "${pol}/scaling_governor" 2>/dev/null || true
    echo "${epp}" > "${pol}/energy_performance_preference" 2>/dev/null || true
  done
  if pstate_clamped; then
    log "amd_pstate is still clamped; retrying in ${PSTATE_RETRY}s."
    install -d -m 755 "${RUN_DIR}"
    echo "${now}" > "${PSTATE_FAIL_STAMP}"
  else
    log "amd_pstate clamp cleared (governor ${gov}, EPP ${epp})."
  fi
}

reapply() {
  local mode
  with_lock
  pstate_unclamp
  mode="$(stored_mode)"
  if ! valid_mode "${mode}"; then
    publish_state
    exec 9>&-
    return 0
  fi
  # CO resets with the limits, so always send the full set here.
  if apply_mode "${mode}"; then
    log "Re-applied ${mode}: $(read_limits)"
  fi
  if [[ "${mode}" != perf ]]; then
    set_nvidia_auto
  fi
  publish_state
  exec 9>&-
}

check() {
  local mode limits profile adopted
  # Skip quietly if a user action currently holds the lock.
  install -d -m 755 "${RUN_DIR}"
  exec 9> "${LOCK_FILE}"
  flock -n 9 || return 0
  pstate_unclamp
  mode="$(stored_mode)"
  profile="$(current_profile)"
  adopted="$(profile_mode "${profile}")"
  if valid_mode "${mode}" && valid_mode "${adopted}" && [[ "${adopted}" != "${mode}" ]]; then
    # Someone else (KDE's power slider, Fn+F5) picked a profile: follow it.
    log "Power profile changed to ${profile} outside px13; switching to ${adopted}."
    write_mode "${adopted}"
    apply_mode "${adopted}" || true
    if [[ "${adopted}" != perf ]]; then
      set_nvidia_auto
    fi
  elif valid_mode "${mode}"; then
    limits="$(read_limits || true)"
    if [[ -n "${limits}" ]] && ! limits_match "${limits}" "${mode}"; then
      log "Firmware overrode ${mode} limits (${limits} W); re-applying."
      apply_mode "${mode}" || true
    fi
    # power-profiles-daemon rewrites EPP on its own events (AC changes).
    apply_mode_epp "${mode}"
    apply_mode_fans "${mode}"
    if ((FANS_CHANGED)); then
      sleep 1.5
      apply_mode_limits "${mode}" || true
    fi
  fi
  cpu_auto_apply
  optimized_apply
  publish_state
  exec 9>&-
}

# Polls the platform profile every 2s without running external commands, and runs
# the full RyzenAdj check when it changes or every WATCH_INTERVAL seconds.
# Also tracks AC changes: on unplug the EC reloads its own limits more than
# once (at ~1-2s and again ~20s), so check at +3s and again at +25s.
watch_loop() {
  local tick="${RUN_DIR}/tick" elapsed=0 expected ac="" last_ac="" ac_recheck=-1
  reapply || true
  rm -f "${tick}"
  mkfifo -m 600 "${tick}"
  exec 8<> "${tick}"
  read -r last_ac 2>/dev/null < "${AC_ONLINE}" || true
  printf '0\n' > "${AC_SINCE_FILE}"
  check || true
  while true; do
    read -r -t 2 -u 8 _ || true
    elapsed=$((elapsed + 2))
    read -r ac 2>/dev/null < "${AC_ONLINE}" || true
    expected="$(mode_profile "$(stored_mode)")"
    if [[ "${ac}" != "${last_ac}" ]]; then
      last_ac="${ac}"
      date +%s > "${AC_SINCE_FILE}"
      read -r -t 3 -u 8 _ || true
      check || true
      elapsed=0
      ac_recheck=22
    elif [[ "${expected}" != unknown && "$(current_profile)" != "${expected}" ]]; then
      check || true
      elapsed=0
    elif ((ac_recheck > 0)); then
      ac_recheck=$((ac_recheck - 2))
      if ((ac_recheck <= 0)); then
        check || true
        elapsed=0
      fi
    elif ((elapsed >= WATCH_INTERVAL)); then
      check || true
      elapsed=0
    fi
  done
}

cycle() {
  local next
  case "$(stored_mode)" in
    eco) next=normal ;;
    normal) next=perf ;;
    *) next=eco ;;
  esac
  set_mode "${next}"
}

# Unload the NVIDIA driver so the firmware can eject the GPU. Fails quietly
# if something still uses it; nvidia_detach then handles the usual cause.
nvidia_unload() {
  local mod
  [[ -d /sys/module/nvidia || -d /sys/module/nouveau ]] || return 0
  # shellcheck disable=SC2086  # a list of units
  systemctl stop ${NVIDIA_SERVICES} >/dev/null 2>&1 || true
  for mod in nvidia_drm nvidia_modeset nvidia_uvm nvidia nouveau; do
    [[ -d "/sys/module/${mod}" ]] && modprobe -r "${mod}" >/dev/null 2>&1 || true
  done
  [[ ! -d /sys/module/nvidia && ! -d /sys/module/nouveau ]]
}

# /dev/dri nodes of the dGPU: $1 = card (display) or render.
nvidia_drm_nodes() {
  local dev
  for dev in $(nvidia_devices); do
    ls "/dev/dri/by-path/pci-${dev}-$1" 2>/dev/null || true
  done
}

# "pid name" for each process rendering or computing on the dGPU (the
# /dev/nvidia* devices and the render node). Holding only the display node,
# as the compositor does, does not count; neither do the NVIDIA services,
# which GPU Eco stops itself.
nvidia_client_pids() {
  local nodes pid comm
  nodes="$(ls /dev/nvidia* 2>/dev/null; nvidia_drm_nodes render)"
  [[ -n "${nodes}" ]] || return 0
  # shellcheck disable=SC2086  # one argument per node
  for pid in $(fuser ${nodes} 2>/dev/null | tr -cs '0-9' ' '); do
    comm="$(ps -o comm= -p "${pid}" 2>/dev/null)" || continue
    [[ "${comm}" == nvidia-persiste* || "${comm}" == nvidia-powerd ]] && continue
    printf '%s %s\n' "${pid}" "${comm}"
  done | sort -un
}

# Comma-separated names of those processes.
nvidia_clients() {
  nvidia_client_pids | awk '{print $2}' | sort -u | paste -sd, -
}

# The given pids that are still running.
alive() {
  local pid
  for pid in "$@"; do
    kill -0 "${pid}" 2>/dev/null && echo "${pid}"
  done
  return 0
}

# Close the invoking user's apps that use the dGPU: SIGTERM, then SIGKILL
# whatever is left after 5s. Refuses (closing nothing) if a session or
# system process uses it, since closing those would end the session.
close_gpu_apps() {
  local uid="${SUDO_UID:-}" pid comm owner i
  local -a pids=() names=() blocked=()
  if [[ -z "${uid}" ]]; then
    echo "Closing GPU apps needs to run through sudo from your session." >&2
    return 1
  fi
  # shellcheck disable=SC2086  # a list of units
  systemctl stop ${NVIDIA_SERVICES} >/dev/null 2>&1 || true
  while read -r pid comm; do
    owner="$(stat -c %u "/proc/${pid}" 2>/dev/null)" || continue
    if [[ "${owner}" != "${uid}" || " ${PROTECTED_PROCS} " == *" ${comm} "* ]]; then
      blocked+=("${comm}")
    else
      pids+=("${pid}"); names+=("${comm}")
    fi
  done < <(nvidia_client_pids)
  if ((${#blocked[@]})); then
    echo "Not closing anything: $(printf '%s\n' "${blocked[@]}" | sort -u | paste -sd, -) uses the GPU and cannot be closed from here." >&2
    return 1
  fi
  ((${#pids[@]})) || return 0
  echo "Closing $(printf '%s\n' "${names[@]}" | sort -u | paste -sd, -)..."
  kill -TERM "${pids[@]}" 2>/dev/null || true
  for ((i = 0; i < 10; i++)); do
    [[ -n "$(alive "${pids[@]}")" ]] || break
    sleep 0.5
  done
  if [[ -n "$(alive "${pids[@]}")" ]]; then
    # shellcheck disable=SC2046  # one argument per pid
    kill -KILL $(alive "${pids[@]}") 2>/dev/null || true
    sleep 1
  fi
  if [[ -n "$(nvidia_clients)" ]]; then
    echo "Still using the GPU: $(nvidia_clients)." >&2
    return 1
  fi
}

# Seconds until another GPU Eco switch is allowed (0 = now).
gpu_cooldown_left() {
  local last=0 left
  read -r last 2>/dev/null < "${GPU_SWITCHED_FILE}" || true
  left=$(( ${last:-0} + GPU_SWITCH_COOLDOWN - $(date +%s) ))
  (( left > 0 )) && echo "${left}" || echo 0
}

gpu_switched_now() {
  date +%s > "${GPU_SWITCHED_FILE}"
}

# Keep the USB4 host interfaces awake (see GPU_SWITCH_COOLDOWN); prints the
# "device control" pairs to restore afterwards.
usb4_hold() {
  local dev
  for dev in /sys/bus/pci/drivers/thunderbolt/0000:*; do
    [[ -e "${dev}/power/control" ]] || continue
    printf '%s %s\n' "${dev}" "$(cat "${dev}/power/control")"
    printf 'on\n' > "${dev}/power/control" 2>/dev/null || true
  done
}

usb4_release() {
  local dev control
  while read -r dev control; do
    [[ -n "${dev}" ]] && printf '%s\n' "${control}" > "${dev}/power/control" 2>/dev/null || true
  done <<< "$1"
}

# Connected outputs (e.g. HDMI-A-1) driven by the dGPU.
nvidia_connected_outputs() {
  local dev conn
  for dev in $(nvidia_devices); do
    for conn in /sys/bus/pci/devices/"${dev}"/drm/card*/card*-*; do
      [[ "$(cat "${conn}/status" 2>/dev/null)" == connected ]] && basename "${conn}" | cut -d- -f2-
    done
  done | paste -sd, -
}

# KWin opens every GPU's display node, including one that appears after login,
# so in a running session the driver cannot be unloaded. Unbinding the GPU
# from the driver works instead: nvidia_modeset_remove() unplugs the DRM device
# (drm_dev_unplug) before the driver waits for its remaining users (595.91,
# nv_pci_remove_helper), and KWin then drops the GPU. That wait is
# uninterruptible, so only unbind when nothing renders or computes on the GPU,
# and do it in the background with a deadline.
nvidia_detach() {
  local clients outputs dev pid i
  clients="$(nvidia_clients)"
  if [[ -n "${clients}" ]]; then
    echo "The NVIDIA GPU is in use by ${clients}; close them and try again." >&2
    return 1
  fi
  outputs="$(nvidia_connected_outputs)"
  if [[ -n "${outputs}" ]]; then
    echo "A display is connected to the NVIDIA GPU (${outputs}); unplug it and try again." >&2
    return 1
  fi
  for dev in $(nvidia_devices); do
    [[ -e "/sys/bus/pci/devices/${dev}/driver" ]] || continue
    # Wake it first: tearing down the display engine of a runtime-suspended
    # GPU logs hundreds of Xid 56 errors.
    printf 'on\n' > "/sys/bus/pci/devices/${dev}/power/control" 2>/dev/null || true
    for ((i = 0; i < 20; i++)); do
      [[ "$(cat "/sys/bus/pci/devices/${dev}/power/runtime_status" 2>/dev/null)" == active ]] && break
      sleep 0.1
    done
    printf '%s\n' "${dev}" > "/sys/bus/pci/devices/${dev}/driver/unbind" &
    pid=$!
    for ((i = 0; i < 30; i++)); do
      kill -0 "${pid}" 2>/dev/null || break
      sleep 0.5
    done
    if kill -0 "${pid}" 2>/dev/null; then
      # It completes on its own once the last user lets go.
      echo "The NVIDIA driver is still waiting for the GPU to be released; try again shortly." >&2
      return 1
    fi
    wait "${pid}" || true
  done
}

gpu_eco_on() {
  local dev rc
  if [[ "$(gpu_eco_state)" == on ]]; then
    echo "GPU Eco is already on: NVIDIA GPU is powered off by firmware."
    return 0
  fi
  nvidia_unload || nvidia_detach || return 1
  # Remaining functions (HDMI audio) are unbound so the eject is clean.
  for dev in $(nvidia_functions); do
    if [[ -e "/sys/bus/pci/devices/${dev}/driver" ]]; then
      printf '%s\n' "${dev}" > "/sys/bus/pci/devices/${dev}/driver/unbind" 2>/dev/null || true
    fi
  done
  echo "Turning GPU Eco on (firmware ejects and powers off the NVIDIA GPU)..."
  local held
  held="$(usb4_hold)"
  rc="$(wmi_devs "${WMI_GPU_ECO}" 1)"
  sleep 1
  usb4_release "${held}"
  gpu_switched_now
  if [[ "$(gpu_eco_state)" != on || -n "$(nvidia_functions)" ]]; then
    echo "GPU Eco did not complete (firmware returned ${rc}); GPU is still on." >&2
    return 1
  fi
  echo "GPU Eco on: NVIDIA GPU powered off. No reboot needed."
}

gpu_eco_off() {
  local rc i dev
  if [[ -e "${ENVY_REMOVE_RULE}" ]]; then
    echo "EnvyControl integrated mode would delete the GPU; switch with 'px13 hybrid'." >&2
    return 1
  fi
  if [[ "$(gpu_eco_state)" == off && -n "$(nvidia_devices)" ]]; then
    echo "GPU Eco is already off: NVIDIA GPU is on the bus."
    return 0
  fi
  echo "Turning GPU Eco off..."
  # The firmware powers the dGPU, sends a Device Check and then waits up to
  # ~20s for the PCIe link. Linux only brings the link up on a root-port
  # rescan, so rescan while the firmware is still waiting: the call then
  # returns 1 within ~1s instead of timing out with 2 (measured: 1.7s total).
  local out pid held
  held="$(usb4_hold)"
  out="$(mktemp "${RUN_DIR}/eco-off.XXXXXX")"
  wmi_devs "${WMI_GPU_ECO}" 0 > "${out}" &
  pid=$!
  sleep 1
  for ((i = 0; i < 50; i++)); do
    [[ -n "$(nvidia_devices)" ]] && break
    # Rescan now and every 2s after (slower firmware power-up is harmless).
    ((i % 4 == 0)) && printf '1\n' > "${NVIDIA_BRIDGE}/rescan"
    sleep 0.5
  done
  wait "${pid}" || true
  usb4_release "${held}"
  gpu_switched_now
  rc="$(cat "${out}")"
  rm -f "${out}"
  if [[ "$(gpu_eco_state)" != off ]]; then
    echo "Firmware did not turn GPU Eco off (returned ${rc})." >&2
    return 1
  fi
  if [[ -z "$(nvidia_devices)" ]]; then
    printf '1\n' > "${NVIDIA_BRIDGE}/rescan"
    sleep 1
  fi
  if [[ -z "$(nvidia_devices)" ]]; then
    echo "GPU Eco is off but the GPU did not appear after a rescan." >&2
    return 1
  fi
  # Let an idle GPU drop to D3cold through runtime PM.
  for dev in $(nvidia_functions); do
    printf 'auto\n' > "/sys/bus/pci/devices/${dev}/power/control" 2>/dev/null || true
  done
  echo "GPU Eco off: NVIDIA GPU on the bus (driver: $(gpu_driver))."
}

gpu_policy() {
  local policy=""
  read -r policy 2>/dev/null < "${GPU_POLICY_FILE}" || true
  [[ "${policy}" == optimized ]] && echo optimized || echo manual
}

write_gpu_policy() {
  install -d -m 755 "${STATE_DIR}"
  printf '%s\n' "$1" > "${GPU_POLICY_FILE}"
  chmod 644 "${GPU_POLICY_FILE}"
}

# Comma-separated names of processes keeping the GPU from switching off.
nvidia_holders() {
  nvidia_clients
}

# Enforce the optimized policy; caller holds the px13 lock.
optimized_apply() {
  local since=0 eco
  if [[ "$(gpu_policy)" != optimized ]] || ! ec_available; then
    rm -f "${GPU_BUSY_FILE}"
    return 0
  fi
  read -r since 2>/dev/null < "${AC_SINCE_FILE}" || true
  (( $(date +%s) - ${since:-0} >= OPTIMIZED_SETTLE )) || return 0
  (( $(gpu_cooldown_left) == 0 )) || return 0   # retried at the next check
  eco="$(gpu_eco_state)"
  if ! on_ac && [[ "${eco}" == off ]]; then
    if gpu_eco_on >/dev/null 2>&1; then
      rm -f "${GPU_BUSY_FILE}"
      log "Optimized: on battery, GPU Eco on."
    else
      # Same rule as a manual click: never kill apps; retry at the next check.
      nvidia_holders > "${GPU_BUSY_FILE}"
      log "Optimized: GPU in use by $(cat "${GPU_BUSY_FILE}"); keeping it on."
    fi
  elif on_ac && [[ "${eco}" == on ]]; then
    rm -f "${GPU_BUSY_FILE}"
    if [[ -e "${ENVY_REMOVE_RULE}" ]]; then
      log "Optimized: EnvyControl is in integrated mode; run 'px13 hybrid' once first."
    elif gpu_eco_off >/dev/null 2>&1; then
      log "Optimized: on AC, GPU Eco off."
    else
      log "Optimized: could not turn GPU Eco off."
    fi
  else
    rm -f "${GPU_BUSY_FILE}"
  fi
}

optimized() {
  with_lock
  if ! ec_available; then
    echo "asus-nb-wmi debugfs is not available; cannot switch GPU Eco." >&2
    return 1
  fi
  write_gpu_policy optimized
  # Apply now rather than waiting for the AC-settle window.
  printf '0\n' > "${AC_SINCE_FILE}"
  optimized_apply
  publish_state
  local power="battery" gpu="on"
  on_ac && power="AC"
  [[ "$(gpu_eco_state)" == on ]] && gpu="off (GPU Eco)"
  echo "GPU Optimized: Eco on battery, Hybrid on AC. Now on ${power}, GPU ${gpu}."
  if [[ -s "${GPU_BUSY_FILE}" ]]; then
    echo "GPU kept on: in use by $(cat "${GPU_BUSY_FILE}"). It switches once they close."
  fi
}

# Refuse a GPU switch too soon after the previous one (see GPU_SWITCH_COOLDOWN).
gpu_cooldown_check() {
  local left
  left="$(gpu_cooldown_left)"
  if (( left > 0 )); then
    echo "The GPU switched moments ago; try again in ${left}s." >&2
    return 1
  fi
}

deep_eco() {
  with_lock
  write_gpu_policy manual
  rm -f "${GPU_BUSY_FILE}"
  if ! ec_available; then
    echo "asus-nb-wmi debugfs is not available; cannot switch GPU Eco." >&2
    return 1
  fi
  local rc=0
  if [[ "$(gpu_eco_state)" != on ]]; then
    gpu_cooldown_check || return 1
    if [[ "${1:-}" == close ]]; then
      close_gpu_apps || { publish_state; return 1; }
    fi
  fi
  gpu_eco_on || rc=$?
  publish_state
  return "${rc}"
}

hybrid() {
  with_lock
  write_gpu_policy manual
  rm -f "${GPU_BUSY_FILE}"
  if ! ec_available; then
    echo "asus-nb-wmi debugfs is not available; cannot switch GPU Eco." >&2
    return 1
  fi
  local rc=0
  if [[ "$(gpu_eco_state)" != off || -z "$(nvidia_devices)" ]]; then
    gpu_cooldown_check || return 1
  fi
  if [[ "$(gpu_config)" == integrated ]]; then
    if [[ ! -x "${ENVYCONTROL}" || ! -x "${ENVYCONTROL_HELPER}" ]]; then
      echo "EnvyControl integrated mode is set but EnvyControl is not usable." >&2
      return 1
    fi
    echo "Switching EnvyControl to hybrid (rebuilds initramfs, a few minutes)..."
    "${ENVYCONTROL_HELPER}" hybrid-rtd3 || { publish_state; return 1; }
    udevadm control --reload
  fi
  gpu_eco_off || rc=$?
  publish_state
  if [[ "${rc}" -eq 0 ]]; then
    case "$(gpu_driver_issue)" in
      no_module)
        echo "No NVIDIA module for kernel $(uname -r); install linux-modules-nvidia-*-$(uname -r). The GPU idles in D3cold." ;;
      blacklisted)
        echo "Reboot to load the NVIDIA driver; the GPU idles in D3cold until then." ;;
      not_loaded)
        echo "NVIDIA driver not loaded; run 'sudo modprobe nvidia_drm' or reboot. The GPU idles in D3cold." ;;
    esac
  fi
  return "${rc}"
}

battery_report() {
  local bat=/sys/class/power_supply/BAT0 power status
  [[ -d "${bat}" ]] || { echo "No battery found."; return 0; }
  status="$(cat "${bat}/status" 2>/dev/null || echo '?')"
  power="$(awk '{ printf "%.1f", $1 / 1000000 }' "${bat}/power_now" 2>/dev/null || echo '?')"
  printf '%s%% %s, %s W, charge limit %s%%\n' \
    "$(cat "${bat}/capacity" 2>/dev/null || echo '?')" "${status,,}" "${power}" \
    "$(cat "${bat}/charge_control_end_threshold" 2>/dev/null || echo '?')"
}

status() {
  local mode limits dev
  mode="$(stored_mode)"
  limits="$(read_limits || true)"
  publish_state

  echo "Mode:           ${mode}"
  echo "Power profile:  $(current_profile), EPP $(current_epp), auto mode $(cpu_policy)"
  echo "Live limits:    $(tr ' ' '/' <<< "${limits:-unknown}") W (STAPM/slow/fast)"
  echo "Applied:        $(sed -n 's/^applied=//p' "${LIVE_FILE}")"
  echo "Battery:        $(battery_report)"
  echo "GPU Eco:        $(sed -n 's/^gpu_eco=//p' "${LIVE_FILE}") (firmware; driver: $(sed -n 's/^gpu_driver=//p' "${LIVE_FILE}"), EnvyControl config: $(gpu_config), reboot pending: $(sed -n 's/^reboot_pending=//p' "${LIVE_FILE}"))"
  for dev in $(nvidia_devices); do
    echo "NVIDIA ${dev}: control=$(cat "/sys/bus/pci/devices/${dev}/power/control" 2>/dev/null || echo '?') status=$(cat "/sys/bus/pci/devices/${dev}/power/runtime_status" 2>/dev/null || echo '?')"
  done
  echo "Watcher:        $(systemctl is-active px13-watch.service 2>/dev/null || true)"

  if [[ -n "$(nvidia_devices)" ]] && command -v nvidia-smi >/dev/null 2>&1; then
    echo
    echo "NVIDIA-SMI (this wakes the GPU):"
    nvidia-smi || true
  fi

  echo
  echo "RyzenAdj:"
  "${RYZENADJ}" -i 2>/dev/null || echo "RyzenAdj not available."
}

# ---------------------------------------------------------------------- main

cmd="${1:-}"
case "${cmd}" in
  eco|normal|perf|cycle|auto|status|deep-eco|deep-eco-close|hybrid|optimized|gpu-users|reapply|check|watch|state) ;;
  *) usage; exit 1 ;;
esac

# Everything below needs root; re-run through the sudoers rule for px13.
if [[ "${EUID}" -ne 0 ]]; then
  if [[ "${cmd}" == state && -r "${LIVE_FILE}" ]]; then
    cat "${LIVE_FILE}"
    exit 0
  fi
  if ! sudo -n -l "${SELF}" >/dev/null 2>&1; then
    echo "Passwordless sudo for ${SELF} is not available. Check /etc/sudoers.d/px13-power." >&2
    exit 1
  fi
  rc=0
  sudo -n "${SELF}" "$@" || rc=$?
  case "${cmd}" in
    eco|normal|perf|cycle)
      if [[ "${rc}" -eq 0 ]]; then
        notify "PX13 $(stored_mode) mode" "Power limits applied and verified"
      else
        notify "PX13 power mode" "Limits did not verify; see 'px13 status'"
      fi
      ;;
  esac
  exit "${rc}"
fi

case "${cmd}" in
  eco|normal|perf) set_mode "${cmd}" ;;
  cycle) cycle ;;
  auto) auto_cmd "${2:-on}" ;;
  status) status ;;
  deep-eco) deep_eco ;;
  deep-eco-close) deep_eco close ;;
  gpu-users) nvidia_client_pids ;;
  hybrid) hybrid ;;
  optimized) optimized ;;
  reapply) reapply ;;
  check) check ;;
  watch) watch_loop ;;
  state) publish_state; cat "${LIVE_FILE}" ;;
esac
