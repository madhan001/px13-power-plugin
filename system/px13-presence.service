[Unit]
Description=PX13 presence sensor (webcam human-presence engine)
Documentation=file:///usr/local/bin/px13-presence
# The sensor lives in the webcam; start after USB/udev settle.
After=systemd-udev-settle.service

[Service]
Type=simple
ExecStart=/usr/local/bin/px13-presence
Restart=on-failure
RestartSec=5
Nice=10
# Hardening: needs only sysfs (iio buffer/scan settings), /dev/iio:device*,
# and its own runtime directory.
ProtectSystem=strict
ReadWritePaths=/run/px13
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=char-iio rw
MemoryMax=64M

[Install]
WantedBy=multi-user.target
